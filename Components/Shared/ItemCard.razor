@* Card for a lost/found listing. Fields follow the ItemPost contract in the README. *@

<article class="item-card">
    <div class="item-media">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="@Title" loading="lazy" />
        }
        else
        {
            <div class="item-media-placeholder" aria-hidden="true">No photo</div>
        }

        @if (!string.IsNullOrWhiteSpace(PostType))
        {
            <span class="item-type item-type-@(PostType.ToLowerInvariant())">@PostType</span>
        }
    </div>

    <div class="item-body">
        <div class="item-heading">
            <h3 class="item-title">@Title</h3>
            @if (!string.IsNullOrWhiteSpace(Status))
            {
                <StatusBadge Status="@Status" />
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="item-description">@Description</p>
        }

        <ul class="item-meta">
            @if (!string.IsNullOrWhiteSpace(Category))
            {
                <li><span class="meta-label">Category</span>@Category</li>
            }
            @if (!string.IsNullOrWhiteSpace(Location))
            {
                <li><span class="meta-label">Location</span>@Location</li>
            }
            @if (DatePosted is not null)
            {
                <li><span class="meta-label">Posted</span>@DatePosted.Value.ToString("d MMM yyyy")</li>
            }
        </ul>
    </div>

    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <div class="item-footer">
            <a class="item-link" href="@Href">View details <span aria-hidden="true">→</span></a>
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Category { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public DateTime? DatePosted { get; set; }

    // "Lost" or "Found"
    [Parameter] public string? PostType { get; set; }

    // e.g. "Open", "Pending", "Claimed"
    [Parameter] public string? Status { get; set; }

    // Link to the detail page. The footer is hidden when not set.
    [Parameter] public string? Href { get; set; }
}

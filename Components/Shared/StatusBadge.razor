@* Small pill that shows an item or claim status, e.g. Open, Pending, Claimed, Denied. *@

<span class="status-badge status-@Variant">
    <span class="status-dot" aria-hidden="true"></span>
    @(Label ?? Status)
</span>

@code {
    [Parameter, EditorRequired] public string Status { get; set; } = "";

    // Optional display text when it should differ from the status value.
    [Parameter] public string? Label { get; set; }

    private string Variant => Status.Trim().ToLowerInvariant() switch
    {
        "open" or "lost" => "info",
        "found" => "teal",
        "pending" or "in review" => "warning",
        "claimed" or "approved" or "returned" or "resolved" => "success",
        "denied" or "rejected" => "danger",
        _ => "neutral"
    };
}

@* Filter controls for the feed: category, location, status and date range.
   Structure only for now. The feed page owns the ItemFilter and does the filtering. *@

<section class="filter-panel" aria-label="Filter items">
    <div class="filter-header">
        <h3>
            Filters
            @if (Filter.ActiveCount > 0)
            {
                <span class="filter-count">@Filter.ActiveCount</span>
            }
        </h3>
        <button type="button" class="filter-reset" disabled="@Filter.IsEmpty" @onclick="Reset">Clear all</button>
    </div>

    <div class="filter-fields">
        <div class="filter-field">
            <label for="filter-category">Category</label>
            <select id="filter-category" @bind="Filter.Category" @bind:after="NotifyChanged">
                <option value="">All categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label for="filter-location">Location</label>
            <select id="filter-location" @bind="Filter.Location" @bind:after="NotifyChanged">
                <option value="">All locations</option>
                @foreach (var location in Locations)
                {
                    <option value="@location">@location</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label for="filter-status">Status</label>
            <select id="filter-status" @bind="Filter.Status" @bind:after="NotifyChanged">
                <option value="">Any status</option>
                @foreach (var status in Statuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>

        <fieldset class="filter-field filter-dates">
            <legend>Date posted</legend>
            <div class="date-row">
                <label>
                    <span class="visually-hidden">From</span>
                    <input type="date" aria-label="From date" @bind="Filter.DateFrom" @bind:after="NotifyChanged" />
                </label>
                <span class="date-sep" aria-hidden="true">–</span>
                <label>
                    <span class="visually-hidden">To</span>
                    <input type="date" aria-label="To date" @bind="Filter.DateTo" @bind:after="NotifyChanged" />
                </label>
            </div>
        </fieldset>
    </div>
</section>

@code {
    [Parameter] public ItemFilter Filter { get; set; } = new();
    [Parameter] public EventCallback<ItemFilter> FilterChanged { get; set; }

    [Parameter] public IReadOnlyList<string> Categories { get; set; } =
        ["Electronics", "ID & Cards", "Keys", "Bags", "Clothing", "Books & Stationery", "Bottles", "Other"];

    [Parameter] public IReadOnlyList<string> Locations { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Statuses { get; set; } = ["Open", "Pending", "Claimed"];

    private Task NotifyChanged() => FilterChanged.InvokeAsync(Filter);

    private Task Reset()
    {
        Filter.Reset();
        return NotifyChanged();
    }
}

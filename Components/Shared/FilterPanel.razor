@* Filter controls for the feed: category, location, status and date range.
   The parent owns the ItemFilter and does the filtering (see ItemFeed and Helpers/ItemQuery). *@

<section class="filter-panel" aria-label="Filter items">
    <div class="filter-header">
        <h3>
            Filters
            @if (Filter.ActiveCount > 0)
            {
                <span class="filter-count">@Filter.ActiveCount</span>
            }
        </h3>
        <button type="button" class="filter-reset" disabled="@Filter.IsEmpty" @onclick="Reset">Clear all</button>
    </div>

    <div class="filter-fields">
        <div class="filter-field">
            <label for="@($"{idPrefix}-category")">Category</label>
            <select id="@($"{idPrefix}-category")" @bind="Filter.Category" @bind:after="NotifyChanged">
                <option value="">All categories</option>
                @foreach (var category in Categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label for="@($"{idPrefix}-location")">Location</label>
            <select id="@($"{idPrefix}-location")" @bind="Filter.Location" @bind:after="NotifyChanged">
                <option value="">All locations</option>
                @foreach (var location in Locations)
                {
                    <option value="@location">@location</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label for="@($"{idPrefix}-status")">Status</label>
            <select id="@($"{idPrefix}-status")" @bind="Filter.Status" @bind:after="NotifyChanged">
                <option value="">Any status</option>
                @foreach (var status in Statuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>

        <fieldset class="filter-field filter-dates">
            <legend>Date posted</legend>
            <div class="date-row">
                <label>
                    <span class="visually-hidden">From</span>
                    <input type="date" aria-label="From date" max="@DateAttr(Filter.DateTo ?? DateTime.Today)"
                           @bind="Filter.DateFrom" @bind:after="NotifyChanged" />
                </label>
                <span class="date-sep" aria-hidden="true">–</span>
                <label>
                    <span class="visually-hidden">To</span>
                    <input type="date" aria-label="To date" min="@DateAttr(Filter.DateFrom)" max="@DateAttr(DateTime.Today)"
                           @bind="Filter.DateTo" @bind:after="NotifyChanged" />
                </label>
            </div>
        </fieldset>
    </div>
</section>

@code {
    [Parameter] public ItemFilter Filter { get; set; } = new();
    [Parameter] public EventCallback<ItemFilter> FilterChanged { get; set; }

    [Parameter] public IReadOnlyList<string> Categories { get; set; } =
        ["Electronics", "ID & Cards", "Keys", "Bags", "Clothing", "Books & Stationery", "Bottles", "Other"];

    [Parameter] public IReadOnlyList<string> Locations { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Statuses { get; set; } = ["Open", "Pending", "Claimed"];

    // Unique per instance so labels still work when two panels are on one page.
    private readonly string idPrefix = $"filter-{Guid.NewGuid():N}";

    private Task NotifyChanged() => FilterChanged.InvokeAsync(Filter);

    // null renders no attribute.
    private static string? DateAttr(DateTime? date) => date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private Task Reset()
    {
        Filter.Reset();
        return NotifyChanged();
    }
}

@page "/login"
@rendermode InteractiveServer
@using Reklaim_frontend.Components.Auth

<PageTitle>Login</PageTitle>

<section class="page-section">
    <div class="page-card">
        <p class="section-label">Authentication</p>
        <h2>Welcome back</h2>
        <p class="muted-text">Sign in with your university email to continue.</p>

        <LoginForm />

        <p class="muted-text">
            Don't have an account? <a href="/register">Create one</a>
        </p>
    </div>
</section>
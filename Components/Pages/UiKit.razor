@page "/ui-kit"
@rendermode InteractiveServer
@using Reklaim_frontend.Services
@inject IPostService PostService

@* Preview of the shared components so they can be reviewed before use on real pages. Sample data only. *@

<PageTitle>UI Kit</PageTitle>

<section class="hero-panel">
    <div>
        <p class="section-label">Shared components</p>
        <h2>UI kit preview</h2>
    </div>
</section>

<div class="kit-section">
    <h3>Buttons</h3>
    <div class="kit-row">
        <button class="primary-btn" type="button">Primary</button>
        <button class="secondary-btn" type="button">Secondary</button>
        <button class="danger-btn" type="button">Danger</button>
        <button class="primary-btn" type="button" disabled>Disabled</button>
        <a class="primary-btn" href="ui-kit">Link as button</a>
    </div>
</div>

<div class="kit-section">
    <h3>Alerts</h3>
    <div class="alert alert-success" role="status">Post created successfully.</div>
    <div class="alert alert-info" role="status">Your claim is being reviewed.</div>
    <div class="alert alert-warning" role="status">This item already has a pending claim.</div>
    <div class="alert alert-danger" role="alert">
        We could not load listings right now.
        <button class="secondary-btn" type="button">Try again</button>
    </div>
</div>

<div class="kit-section">
    <h3>SearchBar</h3>
    <SearchBar @bind-Value="query" OnSearch="q => lastSearch = q" />
    <p class="muted-text kit-note">Typing: "@query" · Last search: "@lastSearch"</p>
</div>

<div class="kit-section">
    <h3>StatusBadge</h3>
    <div class="kit-row">
        @foreach (var status in new[] { "Open", "Found", "Pending", "Claimed", "Denied", "Archived" })
        {
            <StatusBadge Status="@status" />
        }
    </div>
</div>

<div class="kit-section">
    <h3>LoadingSpinner</h3>
    <div class="kit-row">
        <LoadingSpinner Size="sm" Inline="true" Label="Saving..." />
        <LoadingSpinner Size="md" Inline="true" Label="" />
        <LoadingSpinner Size="lg" Inline="true" Label="" />
    </div>
    <LoadingSpinner Label="Loading items..." />
</div>

<div class="kit-section">
    <h3>EmptyState</h3>
    <EmptyState Icon="⌕" Title="No items match your search" Message="Try a different keyword or clear your filters.">
        <button class="secondary-btn" type="button">Clear filters</button>
        <button class="primary-btn" type="button">Report an item</button>
    </EmptyState>
</div>

<div class="kit-section">
    <h3>ItemFeed (search, filters, sort, card list)</h3>
    <div class="kit-row kit-toggle" role="group" aria-label="Post type">
        @foreach (var option in new string?[] { null, "Lost", "Found" })
        {
            <button type="button"
                    class="@(postType == option ? "primary-btn" : "secondary-btn")"
                    aria-pressed="@(postType == option ? "true" : "false")"
                    @onclick="() => postType = option">
                @(option ?? "All")
            </button>
        }
        <button type="button" class="secondary-btn" @onclick="SimulateLoading">Simulate loading</button>
    </div>
    <ItemFeed Items="feedItems" PostType="@postType" SyncWithUrl="true" />
    <p class="muted-text kit-note">Search, filters and sort are kept in the URL. Try refreshing or pressing back.</p>
</div>

<div class="kit-section">
    <h3>ItemFeed with no items</h3>
    <ItemFeed Items="noItems">
        <EmptyContent>
            <button class="primary-btn" type="button">Report an item</button>
        </EmptyContent>
    </ItemFeed>
</div>

@code {
    private string? query;
    private string? lastSearch;

    private IReadOnlyList<ItemPostDto>? feedItems;
    private readonly IReadOnlyList<ItemPostDto> noItems = [];
    private string? postType;

    protected override async Task OnInitializedAsync()
    {
        feedItems = await PostService.GetAllAsync();
    }

    private async Task SimulateLoading()
    {
        feedItems = null;
        await Task.Delay(1500);
        feedItems = await PostService.GetAllAsync();
    }
}

@page "/post-details/{Id:int}"
@rendermode InteractiveServer
@using Reklaim_frontend.Services
@inject IPostService PostService
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Post Details</PageTitle>

<section class="page-section">
    <div class="page-card">
        <p class="section-label">Listing</p>
        <h2>Item details</h2>

        @if (post is null)
        {
            <div>Loading...</div>
        }
        else
        {
            <div class="row">
                <div class="col-md-6">
                    <!-- image src -->
                    @if (!string.IsNullOrEmpty(primaryImage))
                    {
                        <img src="@primaryImage!" alt="item image" style="max-width:100%;height:auto;" />
                    }
                    else
                    {
                        <div class="placeholder-box">No image available</div>
                    }
                </div>
                <div class="col-md-6">
                    <dl>
                        <dt>Title</dt>
                        <dd>@post!.Title</dd>
                        <dt>Description</dt>
                        <dd>@post!.Description</dd>
                        <dt>Category</dt>
                        <dd>@post!.Category</dd>
                        <dt>Location</dt>
                        <dd>@post!.LocationFound</dd>
                        <dt>Posted</dt>
                        <dd>@post!.DatePosted.ToLocalTime().ToString("g")</dd>
                        <dt>Status</dt>
                        <dd>
                            <StatusBadge Status="@post!.Status" />
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <!-- claim request and component parameter -->
                        @if (post != null && !showClaimForm && CanClaim(post.Status))
                        {
                            <button type="button" class="btn btn-primary" @onclick="ShowClaimForm" disabled="@isUpdating">Claim this item</button>
                        }

                        @if (post != null && showClaimForm)
                        {
                            <ClaimRequest ItemId="@post!.Id" OnSubmitted="OnClaimSubmitted" />
                        }

                    
                        @if (!string.IsNullOrEmpty(actionMessage))
                        {
                            <div class="mt-2 alert @actionClass">@actionMessage</div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public int Id { get; set; }

    private ItemPostDto? post;
    private string? primaryImage;
    private bool isUpdating;
    private string? actionMessage;
    private string actionClass = "";
    private bool showClaimForm;

    protected override async Task OnInitializedAsync()
    {
        // Check query string for created flag so we can show a success banner after redirect from creation.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("created", out var createdVal) && createdVal == "1")
        {
            actionMessage = "Post created successfully.";
            actionClass = "alert-success";
        }

        post = await PostService.GetByIdAsync(Id);
        if (post != null)
        {
            primaryImage = post.ImageUrls?.FirstOrDefault() ?? post.ImageUrl;
        }
    }

    private async Task ClaimItem()
    {
        if (post == null) return;
        isUpdating = true;
        actionMessage = null;
        try
        {
            // set to Pending to indicate claimant has requested
            var ok = await PostService.UpdateStatusAsync(post.Id, "Pending");
            if (ok)
            {
                actionMessage = "Claim request sent.";
                actionClass = "alert-success";
                post.Status = "Pending";
            }
            else
            {
                actionMessage = "Failed to send claim request.";
                actionClass = "alert-danger";
            }
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task OnClaimSubmitted(bool success)
    {
        showClaimForm = false;
        if (success && post != null)
        {
            actionMessage = "Claim request submitted.";
            actionClass = "alert-success";
            post.Status = "Pending";
        }
        else if (!success)
        {
            // only show failure when there is an explicit message
            actionMessage = "Claim submission cancelled or failed.";
            actionClass = "alert-danger";
        }
        await InvokeAsync(StateHasChanged);
    }

    private static bool CanClaim(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return false;
        var s = status.Trim().ToLowerInvariant();
        return s == "open" || s == "found" || s == "lost";
    }

    private async Task ShowClaimForm()
    {
        showClaimForm = true;
        // log to browser console so we can confirm the handler ran
        try
        {
            await JS.InvokeVoidAsync("console.log", $"ShowClaimForm invoked for post {post?.Id}");
        }
        catch
        {
            // ignore JS errors during diagnostics
        }
        StateHasChanged();
    }
}

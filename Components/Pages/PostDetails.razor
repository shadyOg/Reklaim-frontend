@page "/post-details/{Id:int}"
@rendermode InteractiveServer
@using Reklaim_frontend.Services
@inject IPostService PostService
@inject IClaimService ClaimService
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>@(post is null ? "Post Details" : $"{post.Title} · Post Details")</PageTitle>

<section class="page-section">
    <div class="page-card wide">
        <a class="back-link" href="/posts"><span aria-hidden="true">←</span> Back to listings</a>
        <p class="section-label">Listing</p>
        <h2>Item details</h2>

        @if (isLoading)
        {
            <LoadingSpinner Label="Loading item..." />
        }
        else if (loadError is not null)
        {
            <div class="alert alert-danger" role="alert">
                @loadError
                <button class="secondary-btn" type="button" @onclick="LoadPostAsync">Try again</button>
            </div>
        }
        else if (post is null)
        {
            <EmptyState Icon="?" Title="Item not found" Message="This listing may have been removed, or the link is wrong.">
                <a class="primary-btn" href="/posts">Browse listings</a>
            </EmptyState>
        }
        else
        {
            @if (submittedClaim is not null)
            {
                <ClaimStatusNotice Claim="submittedClaim" />
            }
            else if (!string.IsNullOrEmpty(actionMessage))
            {
                <div class="alert @actionClass" role="@(actionClass == "alert-danger" ? "alert" : "status")">@actionMessage</div>
            }

            <div class="detail-layout">
                <div class="detail-media">
                    @if (!string.IsNullOrEmpty(primaryImage))
                    {
                        <img src="@primaryImage" alt="Photo of @post.Title" />
                    }
                    else
                    {
                        <div class="detail-media-placeholder">No photo provided</div>
                    }
                </div>

                <div>
                    <div class="detail-heading">
                        <h3>@post.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(post.Status))
                        {
                            <StatusBadge Status="@post.Status" />
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(post.Description))
                    {
                        <p class="detail-description">@post.Description</p>
                    }

                    <dl class="detail-meta">
                        @if (!string.IsNullOrWhiteSpace(post.PostType))
                        {
                            <dt>Type</dt>
                            <dd>@post.PostType</dd>
                        }
                        <dt>Category</dt>
                        <dd>@(post.Category ?? "Not specified")</dd>
                        <dt>Location</dt>
                        <dd>@(post.LocationFound ?? "Not specified")</dd>
                        <dt>Posted</dt>
                        <dd>@post.DatePosted.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd>
                    </dl>

                    @if (showClaimForm)
                    {
                        <ClaimRequestForm PostId="@post.Id"
                                          Submitted="HandleClaimSubmitted"
                                          Cancelled="CancelClaim" />
                    }
                    else if (submittedClaim is null && CanClaim)
                    {
                        <div class="btn-row">
                            <button class="primary-btn" type="button" @onclick="OpenClaimForm">Claim this item</button>
                        </div>
                    }
                    else if (submittedClaim is null)
                    {
                        <p class="form-hint claim-note">This item already has a claim in progress or has been returned.</p>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter]
    public int Id { get; set; }

    private ItemPostDto? post;
    private string? primaryImage;
    private bool isLoading = true;
    private string? loadError;
    private string? actionMessage;
    private string actionClass = "";
    private bool showClaimForm;
    private ClaimRequestDto? submittedClaim;

    // Only open listings can receive a new claim.
    private bool CanClaim => post is not null
        && submittedClaim is null
        && (string.IsNullOrWhiteSpace(post.Status) || post.Status.Equals("Open", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        // Check query string for created flag so we can show a success banner after redirect from creation.
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("created", out var createdVal) && createdVal == "1")
        {
            actionMessage = "Post created successfully.";
            actionClass = "alert-success";
        }

        await LoadPostAsync();
    await LoadExistingClaimAsync();
    }

    private async Task LoadPostAsync()
    {
        isLoading = true;
        loadError = null;
        try
        {
            post = await PostService.GetByIdAsync(Id);
            primaryImage = post?.ImageUrls?.FirstOrDefault() ?? post?.ImageUrl;
        }
        catch (Exception)
        {
            loadError = "We could not load this item right now. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadExistingClaimAsync()
    {
        try
        {
            var claims = await ClaimService.GetMineAsync();
            submittedClaim = claims.FirstOrDefault(claim => claim.PostId == Id);
        }
        catch (Exception)
        {
            // Claim history is supplemental; the item remains usable if it cannot be loaded.
        }
    }

    private void OpenClaimForm() => showClaimForm = true;

    private void CancelClaim() => showClaimForm = false;

    private void HandleClaimSubmitted(ClaimRequestDto claim)
    {
        submittedClaim = claim;
        showClaimForm = false;
    }
}

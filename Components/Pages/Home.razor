@page "/"
@rendermode InteractiveServer
@using Reklaim_frontend.Services

@inject IPostService PostService
@inject NavigationManager Navigation

<PageTitle>Reklaim Hub</PageTitle>

<section class="hero-panel hub-hero">
    <div>
        <p class="section-label">Campus hub</p>
        <h2>Find what is lost. Return what is found.</h2>
        <p class="muted-text">Browse campus listings or report an item for the community.</p>
    </div>

    <a class="primary-btn" href="/post-create">Report an item</a>
</section>

@if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="alert alert-danger" role="alert">
        @loadError
        <button class="secondary-btn" type="button" @onclick="LoadItemsAsync">Try again</button>
    </div>
}
else
{
    <section class="hub-toolbar" aria-label="Listing type">
        <div>
            <p class="section-label">Browse listings</p>
            <h2>@SelectedModeTitle</h2>
        </div>

        <div class="listing-toggle" role="group" aria-label="Choose listing type">
            <button class="@(selectedPostType is null ? "active" : "")"
                    type="button"
                    aria-pressed="@(selectedPostType is null)"
                    @onclick="SelectAll">
                All items
            </button>
            <button class="@(selectedPostType == "Lost" ? "active" : "")"
                    type="button"
                    aria-pressed="@(selectedPostType == "Lost")"
                    @onclick="SelectLost">
                Lost items
            </button>
            <button class="@(selectedPostType == "Found" ? "active" : "")"
                    type="button"
                    aria-pressed="@(selectedPostType == "Found")"
                    @onclick="SelectFound">
                Found items
            </button>
        </div>
    </section>

    <ItemFeed Items="items"
              PostType="selectedPostType"
              SyncWithUrl="true"
              EmptyTitle="No listings yet"
              EmptyMessage="There are no lost or found items to display right now." />
}

@code {
    private IReadOnlyList<ItemPostDto>? items;
    private string? selectedPostType;
    private string? loadError;

    private string SelectedModeTitle => selectedPostType switch
    {
        "Lost" => "Lost items",
        "Found" => "Found items",
        _ => "Lost and found items"
    };

    protected override Task OnInitializedAsync() => LoadItemsAsync();

    private async Task LoadItemsAsync()
    {
        loadError = null;
        items = null;

        try
        {
            items = await PostService.GetAllAsync();
        }
        catch (Exception)
        {
            loadError = "We could not load listings right now. Please try again.";
        }
    }

    private void SelectPostType(string? postType)
    {
        selectedPostType = postType;
    }

    private void SelectAll() => SelectPostType(null);

    private void SelectLost() => SelectPostType("Lost");

    private void SelectFound() => SelectPostType("Found");
}

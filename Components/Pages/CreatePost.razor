@page "/post-create"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Reklaim_frontend.Services
@using Reklaim_frontend.Helpers
@inject IPostService PostService
@inject NavigationManager Navigation
@inject ILogger<CreatePost> Logger

<PageTitle>Create Post</PageTitle>

<section class="page-section">
    <div class="page-card">
        <p class="section-label">Posting</p>
        <h2>Report a lost or found item</h2>
        <p class="muted-text">Fields marked <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

        <EditForm Model="model" OnValidSubmit="HandleValidSubmit" FormName="createPostForm" class="form-stack">
            <DataAnnotationsValidator />

            <div class="form-row">
                <div class="form-group">
                    <label for="post-type">Post type <span class="required-mark" aria-hidden="true">*</span></label>
                    <InputSelect id="post-type" class="form-select" @bind-Value="model.PostType" aria-required="true">
                        <option value="">Select...</option>
                        <option value="Lost">I lost something</option>
                        <option value="Found">I found something</option>
                    </InputSelect>
                    <ValidationMessage For="() => model.PostType" />
                </div>

                <div class="form-group">
                    <label for="post-category">Category <span class="required-mark" aria-hidden="true">*</span></label>
                    <InputSelect id="post-category" class="form-select" @bind-Value="selectedCategory" @bind-Value:after="OnCategoryChanged" aria-required="true">
                        <option value="">@(categories is null ? "Loading..." : "Select...")</option>
                        @if (categories != null)
                        {
                            @foreach (var c in categories)
                            {
                                <option value="@c">@c</option>
                            }
                        }
                        <option value="@OtherCategory">Other...</option>
                    </InputSelect>
                    @if (isOther)
                    {
                        <label for="post-category-other" class="visually-hidden">Custom category</label>
                        <InputText id="post-category-other" class="form-control" @bind-Value="model.Category" placeholder="Enter category" />
                    }
                    <ValidationMessage For="() => model.Category" />
                </div>
            </div>

            <div class="form-group">
                <label for="post-title">Title <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="post-title" class="form-control" @bind-Value="model.Title" placeholder="e.g. Blue water bottle" aria-required="true" />
                <ValidationMessage For="() => model.Title" />
            </div>

            <div class="form-group">
                <label for="post-description">Description <span class="required-mark" aria-hidden="true">*</span></label>
                <InputTextArea id="post-description" class="form-control" @bind-Value="model.Description" aria-required="true" aria-describedby="post-description-hint" />
                <span id="post-description-hint" class="form-hint">Describe colour, brand or marks, but leave out one detail only the owner would know.</span>
                <ValidationMessage For="() => model.Description" />
            </div>

            <div class="form-group">
                <label for="post-location">Location <span class="required-mark" aria-hidden="true">*</span></label>
                <InputText id="post-location" class="form-control" @bind-Value="model.LocationFound" placeholder="e.g. Library, 2nd floor" aria-required="true" aria-describedby="post-location-hint" />
                <span id="post-location-hint" class="form-hint">Where the item was lost or found.</span>
                <ValidationMessage For="() => model.LocationFound" />
            </div>

            <div class="form-group">
                <label for="post-image">Photo (optional)</label>
                <InputFile id="post-image" class="form-control" accept=".png,.jpg,.jpeg" OnChange="OnInputFileChange" aria-describedby="post-image-hint" />
                <span id="post-image-hint" class="form-hint">PNG or JPG, up to 5 MB.</span>
                @if (!string.IsNullOrEmpty(fileError))
                {
                    <span class="validation-message" role="alert">@fileError</span>
                }
                @if (previewDataUrl is not null)
                {
                    <div class="image-preview">
                        <img src="@previewDataUrl" alt="Preview of the selected photo" />
                        <button class="secondary-btn" type="button" @onclick="RemoveImage">Remove photo</button>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert @statusClass" role="@(statusClass == "alert-danger" ? "alert" : "status")">@statusMessage</div>
            }

            <div class="form-actions">
                <button class="primary-btn" type="submit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Posting...</span>
                    }
                    else
                    {
                        <span>Create post</span>
                    }
                </button>
                <button class="secondary-btn" type="button" @onclick="ResetForm" disabled="@isSubmitting">Reset</button>
            </div>
        </EditForm>
    </div>
</section>

@code {
    private const string OtherCategory = "__other";
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private static readonly string[] DefaultCategories = [
        "Electronics", "ID & Cards", "Keys", "Bags", "Clothing",
        "Books & Stationery", "Bottles", "Wallets", "Other"
    ];
    private static readonly string[] AllowedImageTypes = ["image/png", "image/jpeg"];

    private CreateModel model = new();
    private List<string>? categories;
    private string? selectedCategory;
    private bool isOther;
    private bool isSubmitting;
    private string? statusMessage;
    private string statusClass = "";
    private string? fileError;
    private byte[]? imageBytes;
    private string? imageFileName;
    private string? previewDataUrl;

    private class CreateModel
    {
        [Required(ErrorMessage = "Please enter a title.")]
        [StringLength(100, ErrorMessage = "Keep the title under 100 characters.")]
        public string? Title { get; set; }

        [Required(ErrorMessage = "Please add a short description.")]
        [StringLength(1000, ErrorMessage = "Keep the description under 1000 characters.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Please say where the item was lost or found.")]
        [StringLength(100, ErrorMessage = "Keep the location under 100 characters.")]
        public string? LocationFound { get; set; }

        [Required(ErrorMessage = "Please choose a category.")]
        public string? Category { get; set; }

        [Required(ErrorMessage = "Please choose whether you lost or found the item.")]
        public string? PostType { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // populate category suggestions from existing posts
        try
        {
            var items = await PostService.GetAllAsync();
            categories = ItemQuery.DistinctValues(items, i => i.Category)
                .Union(DefaultCategories, StringComparer.OrdinalIgnoreCase)
                .Order(StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception)
        {
            categories = DefaultCategories.ToList();
        }
    }

    private void OnCategoryChanged()
    {
        isOther = selectedCategory == OtherCategory;
        model.Category = isOther ? null : selectedCategory;
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        RemoveImage();
        var file = e.File;

        if (!AllowedImageTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            fileError = "That file type isn't supported. Choose a PNG or JPG image.";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            fileError = "That photo is larger than 5 MB. Choose a smaller one.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxImageBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            imageBytes = ms.ToArray();
            imageFileName = file.Name;
            previewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(imageBytes)}";
        }
        catch (Exception)
        {
            fileError = "We couldn't read that photo. Try another file.";
        }
    }

    private void RemoveImage()
    {
        imageBytes = null;
        imageFileName = null;
        previewDataUrl = null;
        fileError = null;
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        statusMessage = null;
        try
        {
            using var fileStream = imageBytes is null ? null : new MemoryStream(imageBytes);

            var request = new CreateItemRequest
            {
                Title = model.Title?.Trim(),
                Description = model.Description?.Trim(),
                LocationFound = model.LocationFound?.Trim(),
                Category = model.Category?.Trim(),
                PostType = model.PostType
            };

            var id = await PostService.CreateAsync(request, fileStream, imageFileName);
            if (id.HasValue)
            {
                // PostDetails shows the success banner when it sees ?created=1
                Navigation.NavigateTo($"post-details/{id.Value}?created=1");
                return;
            }

            statusMessage = "We couldn't create your post. Check that you're signed in and try again.";
            statusClass = "alert-danger";
        }
        catch (HttpRequestException ex)
        {
            statusMessage = ex.Message;
            statusClass = "alert-danger";
        }
        catch (UnauthorizedAccessException ex)
        {
            statusMessage = ex.Message;
            statusClass = "alert-warning";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Create post failed");
            statusMessage = $"Create post failed: {ex.Message}";
            statusClass = "alert-danger";
        }

        isSubmitting = false;
    }

    private void ResetForm()
    {
        model = new CreateModel();
        selectedCategory = null;
        isOther = false;
        statusMessage = null;
        RemoveImage();
    }
}

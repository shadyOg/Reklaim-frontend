@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<section class="page-section">
    <div class="page-card">
        <p class="section-label">Something went wrong</p>
        <h2>We hit an unexpected error</h2>
        <p class="muted-text">Please try again. If the problem continues, let the Reklaim team know.</p>

        @if (ShowRequestId)
        {
            <p class="form-hint">Reference ID: <code>@RequestId</code></p>
        }

        <div class="btn-row">
            <a class="primary-btn" href="">Go to dashboard</a>
        </div>
    </div>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
